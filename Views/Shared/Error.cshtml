@{
    ViewData["Title"] = ViewBag.ErrorTitle ?? "Error";
    bool hasCustomError = ViewBag.ErrorTitle != null || ViewBag.ErrorMessage != null;
    bool hasExceptionDetails = ViewBag.ExceptionMessage != null || ViewBag.StackTrace != null || ViewBag.ExceptionPath != null;
    bool hasStatusCode = ViewBag.StatusCode != null;
}

<div class="row justify-content-center my-4">
    <div class="col-lg-8 col-md-10">
        <div class="card border-danger shadow-sm">
            <div class="card-header bg-danger text-white d-flex align-items-center justify-content-between">
                <h4 class="mb-0">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" class="bi bi-exclamation-triangle-fill me-2" viewBox="0 0 16 16">
                        <path d="M8.982 1.566a1.13 1.13 0 0 0-1.96 0L.165 13.233c-.457.778.091 1.767.98 1.767h13.713c.889 0 1.438-.99.98-1.767zM8 5c.535 0 .954.462.9.995l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 5.995A.905.905 0 0 1 8 5m.002 6a1 1 0 1 1 0 2 1 1 0 0 1 0-2"/>
                    </svg>
                    @(ViewBag.ErrorTitle ?? "An Error Occurred")
                </h4>
                @if (hasStatusCode)
                {
                    <span class="badge bg-light text-danger fs-6">HTTP @ViewBag.StatusCode</span>
                }
            </div>
            <div class="card-body">
                @if (hasCustomError)
                {
                    <div class="alert alert-danger mb-3" role="alert">
                        <h5 class="alert-heading">@(ViewBag.ErrorTitle ?? "Notice")</h5>
                        <p class="mb-0">@ViewBag.ErrorMessage</p>
                    </div>
                }
                else if (!hasExceptionDetails)
                {
                    <div class="alert alert-warning mb-3" role="alert">
                        <p class="mb-0">An unexpected error occurred while processing your request. Please try again later or contact support if the issue persists.</p>
                    </div>
                }

                @if (ViewBag.RoleId != null)
                {
                    <div class="alert alert-info d-flex justify-content-between align-items-center mb-3">
                        <span>Role ID: <code>@ViewBag.RoleId</code></span>
                        <div>
                            <a asp-action="EditUsersInRole" asp-controller="Administration" asp-route-id="@ViewBag.RoleId" class="btn btn-sm btn-outline-primary me-2">Manage Users in Role</a>
                            <a asp-action="ListRoles" asp-controller="Administration" class="btn btn-sm btn-outline-secondary">Back to Roles</a>
                        </div>
                    </div>
                }

                @* Conditionally display technical details / stack traces (in development or when present) *@
                <environment include="Development">
                    @if (hasExceptionDetails)
                    {
                        <div class="card border-secondary mt-3">
                            <div class="card-header bg-secondary text-white">
                                <h5 class="mb-0">Technical Details (Development Mode)</h5>
                            </div>
                            <div class="card-body bg-light">
                                @if (ViewBag.ExceptionPath != null)
                                {
                                    <p><strong>Path:</strong> <code>@ViewBag.ExceptionPath</code></p>
                                }
                                @if (ViewBag.ExceptionMessage != null)
                                {
                                    <p><strong>Exception Message:</strong> <span class="text-danger">@ViewBag.ExceptionMessage</span></p>
                                }
                                @if (ViewBag.StackTrace != null)
                                {
                                    <h6>Stack Trace:</h6>
                                    <pre class="bg-dark text-light p-3 rounded small" style="white-space: pre-wrap; max-height: 400px; overflow-y: auto;"><code>@ViewBag.StackTrace</code></pre>
                                }
                            </div>
                        </div>
                    }
                </environment>

                <environment exclude="Development">
                    @if (hasExceptionDetails && !hasCustomError)
                    {
                        <div class="alert alert-danger mb-3" role="alert">
                            <h5 class="alert-heading">Application Error</h5>
                            <p class="mb-0">An error occurred while processing your request. Our team has been notified. Please contact support if the problem persists.</p>
                        </div>
                    }
                </environment>
            </div>
            <div class="card-footer bg-light d-flex justify-content-between align-items-center">
                <a asp-controller="Home" asp-action="Index" class="btn btn-primary">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-house-door me-1" viewBox="0 0 16 16">
                        <path d="M8.354 1.146a.5.5 0 0 0-.708 0l-6 6A.5.5 0 0 0 1.5 7.5v7a.5.5 0 0 0 .5.5h4.5a.5.5 0 0 0 .5-.5v-4h2v4a.5.5 0 0 0 .5.5H14a.5.5 0 0 0 .5-.5v-7a.5.5 0 0 0-.146-.354L13 5.793V2.5a.5.5 0 0 0-.5-.5h-1a.5.5 0 0 0-.5.5v1.293zM2.5 14V7.707l5.5-5.5 5.5 5.5V14H10v-4a.5.5 0 0 0-.5-.5h-3a.5.5 0 0 0-.5.5v4z"/>
                    </svg>
                    Back to Home
                </a>
                <button type="button" class="btn btn-outline-secondary" onclick="window.history.back();">Go Back</button>
            </div>
        </div>
    </div>
</div>
