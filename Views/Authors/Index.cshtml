@model IEnumerable<Author>

@{
    ViewData["Title"] = "Authors";
    var isAdmin = User.IsInRole("SuperAdmin") || User.IsInRole("Admin");
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-2">
        <div>
            <h1 class="h2 text-primary mb-0">Authors</h1>
            <small class="text-muted">Browse authors and their published works</small>
        </div>
        <div class="d-flex align-items-center gap-2">
            <span class="badge bg-secondary fs-6">Total: @(Model?.Count() ?? 0)</span>
            @if (isAdmin)
            {
                <a asp-action="Create" class="btn btn-success btn-sm">
                    <i class="bi bi-person-plus-fill me-1"></i>Add New Author
                </a>
            }
        </div>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info" role="alert">
            <i class="bi bi-info-circle me-2"></i>No authors found in the store.
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            @foreach (var author in Model)
            {
                var bookCount = author.Books?.Count ?? 0;
                <div class="col">
                    <div class="card h-100 shadow-sm border-0">
                        <div class="card-body d-flex flex-column">
                            <div class="d-flex align-items-center mb-3">
                                <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center me-3" style="width: 48px; height: 48px; font-weight: bold; font-size: 1.2rem;">
                                    @(string.IsNullOrWhiteSpace(author.Name) ? "A" : author.Name.Substring(0, 1).ToUpper())
                                </div>
                                <div class="flex-grow-1 text-truncate">
                                    <h5 class="card-title mb-0 fw-bold text-truncate" title="@author.Name">@author.Name</h5>
                                    <small class="text-muted">Author</small>
                                </div>
                            </div>
                            <p class="card-text text-muted mb-3">
                                Published Works in Store: <span class="badge bg-info text-dark">@bookCount @(bookCount == 1 ? "Book" : "Books")</span>
                            </p>
                            <div class="mt-auto pt-3 border-top d-flex justify-content-between align-items-center">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Details" asp-route-id="@author.Id" class="btn btn-outline-secondary" title="View Author Profile">
                                        <i class="bi bi-eye"></i> Details
                                    </a>
                                    @if (isAdmin)
                                    {
                                        <a asp-action="Edit" asp-route-id="@author.Id" class="btn btn-outline-warning" title="Edit Author">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@author.Id" class="btn btn-outline-danger" title="Delete Author">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    }
                                </div>
                                <a asp-controller="Home" asp-action="Index" asp-route-search="@author.Name" class="btn btn-outline-primary btn-sm">
                                    Explore Books &rarr;
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
