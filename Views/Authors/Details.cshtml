@model AprilBookStore.Models.Author

@{
    ViewData["Title"] = $"{Model.Name} - Author Details";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-2">
        <div>
            <h1 class="h2 text-primary mb-0">@Model.Name</h1>
            <small class="text-muted">Author Profile</small>
        </div>
        <div>
            @if (User.IsInRole("SuperAdmin") || User.IsInRole("Admin"))
            {
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning me-2">
                    <i class="bi bi-pencil me-1"></i>Edit
                </a>
            }
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i>Back to Authors
            </a>
        </div>
    </div>

    <div class="row g-4 mb-5">
        <div class="col-md-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body text-center p-4">
                    <div class="rounded-circle bg-primary text-white d-inline-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px; font-weight: bold; font-size: 2rem;">
                        @(string.IsNullOrWhiteSpace(Model.Name) ? "A" : Model.Name.Substring(0, 1).ToUpper())
                    </div>
                    <h4 class="card-title fw-bold">@Model.Name</h4>
                    <p class="text-muted mb-3">Author</p>
                    <hr />
                    <div class="d-flex justify-content-around text-center">
                        <div>
                            <span class="text-muted small d-block">Published Books</span>
                            <span class="fs-5 fw-bold text-primary">@(Model.Books?.Count ?? 0)</span>
                        </div>
                        <div>
                            <span class="text-muted small d-block">Catalog Status</span>
                            @if (Model.IsVisible)
                            {
                                <span class="badge bg-success">Visible</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Hidden</span>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-8">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-light">
                    <h5 class="mb-0 fw-bold">Books by @Model.Name</h5>
                </div>
                <div class="card-body p-4">
                    @if (Model.Books != null && Model.Books.Any())
                    {
                        <div class="row row-cols-1 row-cols-sm-2 g-3">
                            @foreach (var book in Model.Books.Where(b => b.IsVisible && !b.IsDeleted))
                            {
                                <div class="col">
                                    <div class="card h-100 border shadow-sm">
                                        @if (!string.IsNullOrEmpty(book.ImgPath))
                                        {
                                            <img src="@book.ImgPath" class="card-img-top" style="height: 200px; object-fit: cover;" alt="@book.Name" />
                                        }
                                        <div class="card-body d-flex flex-column">
                                            <h6 class="card-title fw-bold text-truncate" title="@book.Name">@book.Name</h6>
                                            <p class="card-text text-primary fw-bold mb-2">$@string.Format("{0:n2}", book.Price)</p>
                                            <div class="mt-auto">
                                                <a asp-controller="Books" asp-action="Details" asp-route-id="@book.Id" class="btn btn-outline-primary btn-sm w-100">
                                                    View Details
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info mb-0">
                            <i class="bi bi-info-circle me-2"></i>No published books found for this author in the catalog yet.
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
