@page
@model LoginModel
@{
    ViewData["Title"] = "Log in";
}

<div class="container identity-page identity-auth-page my-4 my-lg-5">
    <div class="identity-auth-layout">
        <aside class="identity-editorial-panel" aria-label="AprilBookStore">
            <a class="identity-editorial-brand" asp-controller="Home" asp-action="Index"><span class="identity-brand-mark"><i class="bi bi-book-half" aria-hidden="true"></i></span>April<span>Book</span>Store</a>
            <div class="identity-editorial-art" aria-hidden="true"><span class="identity-art-sun"></span><span class="identity-art-book identity-art-book--one"></span><span class="identity-art-book identity-art-book--two"></span><span class="identity-art-book identity-art-book--three"></span><span class="identity-art-leaf"></span></div>
            <div class="identity-editorial-copy"><p class="identity-eyebrow">A bookstore for curious minds</p><p class="identity-editorial-line">Stories, ideas,<br />and room to wander.</p><span class="identity-editorial-rule"></span></div>
        </aside>
        <section class="identity-form-panel" aria-labelledby="login-heading">
            <div class="identity-form-card">
                <div class="identity-form-heading">
                    <span class="identity-kicker">Your reading room</span>
                    <h1 id="login-heading">Welcome back</h1>
                    <p>Sign in to your AprilBookStore account.</p>
                </div>

                <form id="account" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>
                    <div class="form-floating mb-3">
                        <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                        <label asp-for="Input.Email" class="form-label"></label>
                        <span asp-validation-for="Input.Email" class="text-danger"></span>
                    </div>
                    <div class="form-floating mb-3">
                        <input asp-for="Input.Password" class="form-control" autocomplete="current-password" aria-required="true" placeholder="Password" />
                        <label asp-for="Input.Password" class="form-label"></label>
                        <span asp-validation-for="Input.Password" class="text-danger"></span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div class="form-check">
                            <input class="form-check-input" asp-for="Input.RememberMe" />
                            <label class="form-check-label" asp-for="Input.RememberMe">
                                @Html.DisplayNameFor(m => m.Input.RememberMe)
                            </label>
                        </div>
                        <div>
                            <a id="forgot-password" asp-page="./ForgotPassword" class="text-decoration-none small">Forgot password?</a>
                        </div>
                    </div>
                    <div class="d-grid mb-3">
                        <button id="login-submit" type="submit" class="w-100 btn btn-primary btn-lg">Log in</button>
                    </div>
                </form>

                <div class="text-center mt-2">
                    <p class="text-muted small mb-1">
                        Don't have an account? <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl" class="text-decoration-none fw-semibold">Sign up</a>
                    </p>
                    <p class="text-muted small mb-0">
                        <a id="resend-confirmation" asp-page="./ResendEmailConfirmation" class="text-decoration-none">Resend email confirmation</a>
                    </p>
                </div>

                @if ((Model.ExternalLogins?.Count ?? 0) > 0)
                {
                    <div class="position-relative my-4">
                        <hr />
                        <span class="position-absolute top-50 start-50 translate-middle identity-divider-label px-3 small">or continue with</span>
                    </div>
                    <form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                        <div class="d-grid gap-2">
                            @foreach (var provider in Model.ExternalLogins!)
                            {
                                <button type="submit" class="btn btn-outline-secondary" name="provider" value="@provider.Name" title="Log in using your @provider.DisplayName account">
                                    <i class="bi bi-@(provider.Name.ToLower()) me-1"></i> @provider.DisplayName
                                </button>
                            }
                        </div>
                    </form>
                }
            </div>
        </section>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
