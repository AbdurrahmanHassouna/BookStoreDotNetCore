@page
@model RegisterModel
@{
    ViewData["Title"] = "Register";
}

<div class="container identity-page identity-auth-page my-4 my-lg-5">
    <div class="identity-auth-layout">
        <aside class="identity-editorial-panel" aria-label="AprilBookStore">
            <a class="identity-editorial-brand" asp-controller="Home" asp-action="Index"><span class="identity-brand-mark"><i class="bi bi-book-half" aria-hidden="true"></i></span>April<span>Book</span>Store</a>
            <div class="identity-editorial-art" aria-hidden="true"><span class="identity-art-sun"></span><span class="identity-art-book identity-art-book--one"></span><span class="identity-art-book identity-art-book--two"></span><span class="identity-art-book identity-art-book--three"></span><span class="identity-art-leaf"></span></div>
            <div class="identity-editorial-copy"><p class="identity-eyebrow">A bookstore for curious minds</p><p class="identity-editorial-line">Stories, ideas,<br />and room to wander.</p><span class="identity-editorial-rule"></span></div>
        </aside>
        <section class="identity-form-panel" aria-labelledby="register-heading">
            <div class="identity-form-card">
                <div class="identity-form-heading">
                    <span class="identity-kicker">Make yourself at home</span>
                    <h1 id="register-heading">Create an account</h1>
                    <p>Keep your place in the AprilBookStore collection.</p>
                </div>

                <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>
                    <div class="form-floating mb-3">
                        <input asp-for="Input.UserName" class="form-control" autocomplete="username" aria-required="true" placeholder="Username" />
                        <label asp-for="Input.UserName"></label>
                        <span asp-validation-for="Input.UserName" class="text-danger"></span>
                    </div>
                    <div class="form-floating mb-3">
                        <input asp-for="Input.Email" class="form-control" autocomplete="email" aria-required="true" placeholder="name@example.com" />
                        <label asp-for="Input.Email"></label>
                        <span asp-validation-for="Input.Email" class="text-danger"></span>
                    </div>
                    <div class="form-floating mb-3">
                        <input asp-for="Input.Password" class="form-control" autocomplete="new-password" aria-required="true" placeholder="Password" />
                        <label asp-for="Input.Password"></label>
                        <span asp-validation-for="Input.Password" class="text-danger"></span>
                    </div>
                    <div class="form-floating mb-3">
                        <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="Confirm Password" />
                        <label asp-for="Input.ConfirmPassword"></label>
                        <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                    </div>
                    <div class="d-grid mb-3">
                        <button id="registerSubmit" type="submit" class="w-100 btn btn-primary btn-lg">Register</button>
                    </div>
                </form>

                <div class="text-center mt-2">
                    <p class="text-muted small mb-0">
                        Already have an account? <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl" class="text-decoration-none fw-semibold">Sign in</a>
                    </p>
                </div>

                @if ((Model.ExternalLogins?.Count ?? 0) > 0)
                {
                    <div class="position-relative my-4">
                        <hr />
                        <span class="position-absolute top-50 start-50 translate-middle identity-divider-label px-3 small">or register with</span>
                    </div>
                    <form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                        <div class="d-grid gap-2">
                            @foreach (var provider in Model.ExternalLogins!)
                            {
                                <button type="submit" class="btn btn-outline-secondary" name="provider" value="@provider.Name" title="Log in using your @provider.DisplayName account">
                                    <i class="bi bi-@(provider.Name.ToLower()) me-1"></i> @provider.DisplayName
                                </button>
                            }
                        </div>
                    </form>
                }
            </div>
        </section>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
