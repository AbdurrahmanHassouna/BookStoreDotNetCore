@page
@model ForgotPasswordConfirmation
@{
    ViewData["Title"] = "Forgot password confirmation";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card border-0 shadow-sm rounded-4 p-4 text-center">
                <div class="mb-3">
                    <i class="bi bi-envelope-check text-primary fs-1"></i>
                </div>
                <h3 class="fw-bold mb-2">Check Your Email</h3>
                <p class="text-muted mb-4">
                    Please check your email to reset your password. If an account exists with that address, you will receive instructions shortly.
                </p>
                <div class="d-grid gap-2">
                    <a asp-page="./Login" class="btn btn-outline-primary">Return to Log in</a>
                </div>
            </div>
        </div>
    </div>
</div>
