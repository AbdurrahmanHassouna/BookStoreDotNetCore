@page
@model ForgotPasswordConfirmation
@{
    ViewData["Title"] = "Forgot password confirmation";
}

<div class="container identity-page identity-status-page py-4 py-lg-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card identity-status-card p-4 p-lg-5 text-center">
                <div class="mb-3">
                    <i class="bi bi-envelope-check text-primary fs-1"></i>
                </div>
                <h1 class="identity-status-title mb-2">Check your email</h1>
                <p class="text-muted mb-4">
                    Please check your email to reset your password. If an account exists with that address, you will receive instructions shortly.
                </p>
                <div class="d-grid gap-2">
                    <a asp-page="./Login" class="btn btn-outline-primary">Return to Log in</a>
                </div>
            </div>
        </div>
    </div>
</div>
