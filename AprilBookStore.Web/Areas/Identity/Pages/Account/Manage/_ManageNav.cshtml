@inject SignInManager<ApplicationUser> SignInManager
<div class="card account-nav-panel p-2 p-md-3">
    <ul class="nav nav-pills account-nav flex-column gap-1" aria-label="Account pages">
        <li class="nav-item">
            <a class="nav-link @ManageNavPages.IndexNavClass(ViewContext)" id="profile" asp-page="./Index">
                <i class="bi bi-person-circle me-2"></i> Profile
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link @ManageNavPages.ChangePasswordNavClass(ViewContext)" id="change-password" asp-page="./ChangePassword">
                <i class="bi bi-key-fill me-2"></i> Password
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link" id="YourOrders" asp-action="Index" asp-controller="Orders">
                <i class="bi bi-bag-check-fill me-2"></i> Your Orders
            </a>
        </li>
    </ul>
</div>
