@{
    if (ViewData.TryGetValue("ParentLayout", out var parentLayout) && parentLayout != null)
    {
        Layout = parentLayout.ToString();
    }
    else
    {
        Layout = "/Views/Shared/_Layout.cshtml";
    }
}

<div class="container account-page py-4 py-lg-5">
    <div class="account-heading mb-4 pb-3">
        <p class="identity-eyebrow mb-2">AprilBookStore account</p>
        <h1 class="mb-1">Manage your account</h1>
        <p class="text-muted mb-0">Profile details and sign-in settings</p>
    </div>
    <div class="row account-layout g-4">
        <div class="col-lg-3 col-md-4">
            <aside class="account-sidebar" aria-label="Account settings">
                <partial name="_ManageNav" />
            </aside>
        </div>
        <div class="col-lg-9 col-md-8 account-content">
            @RenderBody()
        </div>
    </div>
</div>

@section Scripts {
    @RenderSection("Scripts", required: false)
}
