@page
@model IndexModel
@{
    ViewData["Title"] = "Profile";
    ViewData["ActivePage"] = ManageNavPages.Index;
}

<div class="card account-panel p-3 p-md-4 p-lg-5">
    <div class="account-panel-heading"><span class="account-panel-icon"><i class="bi bi-person-lines-fill" aria-hidden="true"></i></span><div><p class="identity-eyebrow mb-1">Your details</p><h2 class="mb-0">@ViewData["Title"]</h2></div></div>
    <partial name="_StatusMessage" for="StatusMessage" />
    <form id="profile-form" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>
        <div class="form-floating mb-3">
            <input asp-for="Input.UserName" class="form-control" placeholder="Username" />
            <label asp-for="Input.UserName" class="form-label"></label>
            <span asp-validation-for="Input.UserName" class="text-danger"></span>
        </div>
        <div class="form-floating mb-3">
            <input asp-for="Input.BirthDate" class="form-control" placeholder="Birth Date" />
            <label asp-for="Input.BirthDate" class="form-label"></label>
            <span asp-validation-for="Input.BirthDate" class="text-danger"></span>
        </div>
        <div class="form-floating mb-3">
            <input asp-for="Input.PhoneNumber" class="form-control" placeholder="Phone Number" />
            <label asp-for="Input.PhoneNumber" class="form-label"></label>
            <span asp-validation-for="Input.PhoneNumber" class="text-danger"></span>
        </div>
        <button id="update-profile-button" type="submit" class="btn btn-primary btn-lg">
            <i class="bi bi-save me-1"></i> Save Changes
        </button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
