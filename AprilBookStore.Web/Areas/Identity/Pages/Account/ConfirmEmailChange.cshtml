@page
@model ConfirmEmailChangeModel
@{
    ViewData["Title"] = "Confirm email change";
}

<div class="container identity-page identity-status-page py-4 py-lg-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card identity-status-card p-4 p-lg-5 text-center">
                <div class="mb-3">
                    <i class="bi bi-envelope-check text-primary fs-1" aria-hidden="true"></i>
                </div>
                <h1 class="identity-status-title mb-3">Email change confirmation</h1>
                <partial name="_StatusMessage" model="Model.StatusMessage" />
                <div class="d-grid gap-2 mt-4">
                    <a asp-page="./Manage/Index" class="btn btn-primary btn-lg">Go to Profile</a>
                </div>
            </div>
        </div>
    </div>
</div>
