@page
@model ResendEmailConfirmationModel
@{
    ViewData["Title"] = "Resend email confirmation";
}

<div class="container identity-page identity-form-page py-4 py-lg-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card identity-form-card p-4 p-lg-5">
                <div class="text-center mb-4">
                    <i class="bi bi-send-check identity-form-icon" aria-hidden="true"></i>
                    <h1 class="identity-form-title mt-2">Resend confirmation</h1>
                    <p class="text-muted">Enter your email address to receive a new confirmation email.</p>
                </div>
                <form method="post">
                    <div asp-validation-summary="All" class="text-danger mb-3" role="alert"></div>
                    <div class="form-floating mb-3">
                        <input asp-for="Input.Email" class="form-control" autocomplete="email" aria-required="true" placeholder="name@example.com" />
                        <label asp-for="Input.Email" class="form-label"></label>
                        <span asp-validation-for="Input.Email" class="text-danger"></span>
                    </div>
                    <div class="d-grid gap-2 mb-3">
                        <button type="submit" class="btn btn-primary btn-lg">Resend Email</button>
                    </div>
                    <div class="text-center">
                        <a asp-page="./Login" class="text-decoration-none">
                            <i class="bi bi-arrow-left me-1"></i>Back to Log in
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
