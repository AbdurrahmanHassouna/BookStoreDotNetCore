@page
@model LockoutModel
@{
    ViewData["Title"] = "Locked out";
}

<div class="container identity-page identity-status-page py-4 py-lg-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card identity-status-card p-4 p-lg-5 text-center">
                <div class="mb-3">
                    <i class="bi bi-lock-fill text-danger fs-1"></i>
                </div>
                <h1 class="identity-status-title text-danger mb-2">Account locked</h1>
                <p class="text-muted mb-4">
                    This account has been temporarily locked out due to multiple failed login attempts. Please try again later or reset your password.
                </p>
                <div class="d-grid gap-2">
                    <a asp-page="./ForgotPassword" class="btn btn-primary">Reset Password</a>
                    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">Return to Home</a>
                </div>
            </div>
        </div>
    </div>
</div>
