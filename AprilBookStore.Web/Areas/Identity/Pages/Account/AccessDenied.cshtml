@page
@model AccessDeniedModel
@{
    ViewData["Title"] = "Access Denied";
}

<div class="container identity-page identity-status-page my-4 my-lg-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card identity-status-card p-4 p-lg-5 text-center">
                <div class="mb-3">
                    <i class="bi bi-shield-exclamation text-danger fs-1"></i>
                </div>
                <h1 class="identity-status-title mb-2">@ViewData["Title"]</h1>
                <p class="text-muted mb-4">
                    You do not have permission to access this resource. If you believe this is an error, please contact your administrator.
                </p>
                <div>
                    <a asp-controller="Home" asp-action="Index" class="btn btn-primary btn-lg px-4">
                        <i class="bi bi-house-door me-1"></i> Back to Home
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
