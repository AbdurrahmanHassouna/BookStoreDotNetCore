@page
@model AprilBookStore.Web.Pages.PrivacyModel
@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5">
                <div class="text-center mb-4">
                    <div class="mb-3">
                        <i class="bi bi-shield-check text-primary" style="font-size: 3rem;"></i>
                    </div>
                    <h1 class="display-6 fw-bold">@ViewData["Title"]</h1>
                    <p class="text-muted">Last updated: September 2026</p>
                </div>

                <div class="content lh-lg text-secondary">
                    <h4 class="text-dark fw-semibold mt-4 mb-3">1. Information We Collect</h4>
                    <p>
                        At AprilBookStore, we prioritize the protection of your personal information. When you create an account, purchase books, or browse our store, we collect minimal data required to provide a seamless experience:
                    </p>
                    <ul>
                        <li><strong>Account Details:</strong> Your username, email address, and encrypted credentials.</li>
                        <li><strong>Order Information:</strong> The books you purchase, quantities, purchase timestamps, and transaction totals.</li>
                        <li><strong>Session Data:</strong> Shopping cart items and browsing preferences saved securely for your convenience.</li>
                    </ul>

                    <h4 class="text-dark fw-semibold mt-4 mb-3">2. How We Use Your Information</h4>
                    <p>
                        Your information is used strictly for:
                    </p>
                    <ul>
                        <li>Processing and delivering your book orders.</li>
                        <li>Maintaining your account and order history.</li>
                        <li>Improving store performance, security, and catalog discovery.</li>
                    </ul>

                    <h4 class="text-dark fw-semibold mt-4 mb-3">3. Data Security</h4>
                    <p>
                        We employ modern industry standards including ASP.NET Core Data Protection, HTTPS encryption, parameterization against SQL injection, and automated CSRF tokens on all data-modifying requests.
                    </p>

                    <h4 class="text-dark fw-semibold mt-4 mb-3">4. Contact Us</h4>
                    <p>
                        If you have questions or concerns about our privacy policy or data handling, please contact our support team at <a href="mailto:support@aprilbookstore.com" class="text-primary text-decoration-none">support@aprilbookstore.com</a>.
                    </p>
                </div>

                <div class="text-center mt-4 pt-4 border-top">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-primary rounded-pill px-4">
                        <i class="bi bi-arrow-left me-1"></i>Back to Store
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
