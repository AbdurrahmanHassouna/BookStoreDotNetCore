@model DeleteBookViewModel

@{
    ViewData["Title"] = "Delete";
}

<div class="container workspace-page book-delete-page mt-4 mt-lg-5">
    <header class="workspace-heading"><p class="page-eyebrow">Bookshop administration</p><h1><i class="bi bi-trash me-2" aria-hidden="true"></i>Delete book</h1><p class="text-muted">Review the title before confirming this action.</p></header>
    <div class="row">
        <div class="col-md-6 mb-4">
            <img asp-append-version="true" src="@Model.ImgPath" class="img-fluid rounded shadow" alt="@Model.Name" />
        </div>
        <div class="card detail-surface shadow-sm mb-4 col-md-6">
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-4">
                        <label asp-for="Name"></label>
                    </dt>
                    <dd class="col-sm-8">
                        @Model.Name
                    </dd>
                    <dt class="col-sm-4">
                        <label asp-for="ISBN"></label>
                    </dt>
                    <dd class="col-sm-8">
                        @Model.ISBN
                    </dd>
                    <dt class="col-sm-4">
                        <label asp-for="AuthorName"></label>
                    </dt>
                    <dd class="col-sm-8">
                        @Model.AuthorName
                    </dd>
                </dl>
            </div>
        </div>
    </div>
    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="Id" />
        @Html.AntiForgeryToken()
        <div class="d-flex justify-content-center mt-4">
            <button type="submit" class="btn btn-danger me-2">Delete Book</button>
            <a asp-action="Index" class="btn btn-secondary">Back to List</a>
        </div>
    </form>
</div>
