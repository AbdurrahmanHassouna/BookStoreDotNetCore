@model IPagedList<BookCatalogItemViewModel>

@{
    ViewBag.Title = "Discover Books";
    var currentSearch = Context.Request.Query["search"].ToString();
}

<section class="bookshop-hero mb-5" aria-labelledby="home-heading">
    <div class="bookshop-hero__copy">
        <p class="eyebrow"><span class="eyebrow__rule"></span> An independent bookstore</p>
        <h1 id="home-heading">A good book<br /><em>finds its way</em> to you.</h1>
        <p class="bookshop-hero__intro">A thoughtful collection of stories, ideas, and faraway places. Find the one that feels like yours.</p>
        <form class="hero-search" method="get" asp-action="Index" role="search">
            <label class="visually-hidden" for="catalog-search">Search the book collection</label>
            <i class="bi bi-search" aria-hidden="true"></i>
            <input id="catalog-search" type="search" name="search" class="@(User.IsInRole("SuperAdmin") || User.IsInRole("Admin") ? "SearchAdmin" : "SearchHome")" placeholder="Title, author, or a favorite subject" value="@currentSearch" />
            <button type="submit" class="btn btn-primary">Find a book</button>
        </form>
        <p class="hero-note"><i class="bi bi-book-half" aria-hidden="true"></i> Take your time. There’s plenty to discover.</p>
    </div>
    <div class="bookshop-hero__art" aria-hidden="true">
        <div class="hero-sun"></div>
        <div class="hero-book hero-book--back"></div>
        <div class="hero-book hero-book--middle"></div>
        <div class="hero-book hero-book--front"><span>APRIL<br />BOOKS</span><i></i></div>
        <div class="hero-leaf hero-leaf--one"></div><div class="hero-leaf hero-leaf--two"></div>
        <span class="hero-art-caption">Stories worth keeping</span>
    </div>
</section>

<section aria-labelledby="collection-heading" class="catalog-section">
    <div class="catalog-heading">
        <div>
            <p class="eyebrow mb-2">The collection</p>
            <h2 id="collection-heading">@(string.IsNullOrWhiteSpace(currentSearch) ? "Books to get lost in" : $"Results for “{currentSearch}”")</h2>
        </div>
        @if (!string.IsNullOrWhiteSpace(currentSearch))
        {
            <a asp-action="Index" class="text-link">Clear search <i class="bi bi-arrow-up-right" aria-hidden="true"></i></a>
        }
    </div>

    @await Html.PartialAsync("_Book", Model)

    @if (Model.PageCount > 1)
    {
        <nav aria-label="Book catalog pagination" class="d-flex justify-content-center my-5">
            @Html.PagedListPager(Model, page => Url.Action("Index", new { page, search = currentSearch }),
                new PagedListRenderOptions
                {
                    LiElementClasses = new string[] { "page-item" },
                    PageClasses = new string[] { "page-link" },
                    UlElementClasses = new string[] { "pagination", "justify-content-center", "mb-0" },
                    Display = PagedListDisplayMode.IfNeeded,
                    DisplayPageCountAndCurrentLocation = false
                })
        </nav>
    }
</section>
