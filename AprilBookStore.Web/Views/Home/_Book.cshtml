@model IPagedList<BookCatalogItemViewModel>
@{
    var catalogSearch = Context.Request.Query["search"].ToString();
}

<div class="catalog-grid-wrap">
    @if (!Model.Any())
    {
        <div class="empty-catalog text-center py-5">
            <div class="empty-catalog__mark mb-3" aria-hidden="true"><i class="bi bi-journal-x"></i></div>
            <p class="eyebrow mb-2">@(string.IsNullOrWhiteSpace(catalogSearch) ? "A quiet shelf" : "Try another search")</p>
            <h3 class="text-secondary fw-semibold">@(string.IsNullOrWhiteSpace(catalogSearch) ? "The collection is empty" : "No books found")</h3>
            <p class="text-muted">@(string.IsNullOrWhiteSpace(catalogSearch) ? "There are no titles to show just now." : $"We couldn’t find a match for “{catalogSearch}”. Try another title, author, or subject.")</p>
            <a asp-action="Index" class="btn btn-outline-primary px-3">@(string.IsNullOrWhiteSpace(catalogSearch) ? "Return to the bookstore" : "Clear search and browse")</a>
        </div>
    }
    else
    {
        <div class="row row-cols-2 row-cols-md-3 row-cols-lg-4 row-cols-xl-5 g-3 g-md-4">
            @foreach (var item in Model)
            {
                <div class="col">
                    <article class="card h-100 border-0 book-card">
                        <a asp-action="Details" asp-controller="Books" asp-route-id="@item.Id" class="book-cover-link" aria-label="View details for @item.Name">
                            <div class="book-cover-placeholder" aria-hidden="true"><i class="bi bi-book-half"></i></div>
                            @if (!string.IsNullOrWhiteSpace(item.ImgPath))
                            {
                                <img asp-append-version="true"
                                     src="@item.ImgPath"
                                     class="card-img-top book-cover"
                                     loading="lazy"
                                     onerror="this.hidden=true"
                                     alt="Cover of @item.Name" />
                            }
                        </a>
                        <div class="card-body d-flex flex-column p-2 p-md-3">
                            @if (item.CategoryId.HasValue)
                            {
                                <a asp-controller="Category" asp-action="Details" asp-route-id="@item.CategoryId.Value" class="text-decoration-none align-self-start mb-2">
                                    <span class="badge book-category px-2 py-1 small">
                                        @(string.IsNullOrEmpty(item.CategoryName) ? "General" : item.CategoryName)
                                    </span>
                                </a>
                            }
                            else
                            {
                                <span class="badge book-category align-self-start mb-2 px-2 py-1 small">
                                    @(string.IsNullOrEmpty(item.CategoryName) ? "General" : item.CategoryName)
                                </span>
                            }
                            <h3 class="card-title book-title mb-1" title="@item.Name">
                                <a asp-action="Details" asp-controller="Books" asp-route-id="@item.Id" class="text-decoration-none">
                                    @item.Name
                                </a>
                            </h3>
                            <p class="card-text book-author small mb-2">
                                @if (item.AuthorId.HasValue)
                                {
                                    <a asp-controller="Authors" asp-action="Details" asp-route-id="@item.AuthorId.Value" class="text-decoration-none">
                                        @(item.AuthorName ?? "Unknown Author")
                                    </a>
                                }
                                else
                                {
                                    <span>@(item.AuthorName ?? "Unknown Author")</span>
                                }
                            </p>
                            <div class="book-rating mb-3" aria-label="@(item.BookStar.HasValue ? $"Rating {item.BookStar.Value:0.0} out of 5" : "Not yet rated")">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    <i class="bi @(i <= (int)(item.BookStar ?? 0) ? "bi-star-fill text-warning" : "bi-star text-muted")"></i>
                                }
                                @if (item.BookStar.HasValue && item.BookStar > 0)
                                {
                                    <span class="small text-muted ms-1">(@item.BookStar.Value.ToString("0.0"))</span>
                                }
                            </div>
                            <div class="mt-auto d-flex justify-content-between align-items-center pt-2 border-top">
                                <span class="fw-semibold book-price">$@string.Format("{0:n2}", item.Price)</span>
                                @if (User.Identity?.IsAuthenticated == true)
                                {
                                    @if (item.QuantityInStock <= 0)
                                    {
                                        <button type="button" class="btn btn-outline-danger btn-sm" disabled>
                                            Out of stock
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="button" class="btn btn-primary btn-sm addToCartBtn" data-book-id="@item.Id" title="Add to cart">
                                            <i class="bi bi-cart-plus me-1"></i>Add to Cart
                                        </button>
                                    }
                                }
                                else
                                {
                                    <a asp-area="Identity" asp-page="/account/login" class="btn btn-outline-primary btn-sm" title="Add to cart">
                                        <i class="bi bi-cart-plus me-1"></i>Add to Cart
                                    </a>
                                }
                            </div>
                        </div>
                    </article>
                </div>
            }
        </div>
    }
</div>
