@model IEnumerable<CategoryViewModel>

@{
    ViewData["Title"] = "Categories";
    var isAdmin = User.IsInRole("SuperAdmin") || User.IsInRole("Admin");
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-2">
        <div>
            <h1 class="h2 text-primary mb-0">Categories</h1>
            <small class="text-muted">Browse books by category</small>
        </div>
        <div class="d-flex align-items-center gap-2">
            <span class="badge bg-secondary fs-6">Total: @(Model?.Count() ?? 0)</span>
            @if (isAdmin)
            {
                <a asp-action="Create" class="btn btn-success btn-sm">
                    <i class="bi bi-plus-circle me-1"></i>Add New Category
                </a>
            }
        </div>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info" role="alert">
            <i class="bi bi-info-circle me-2"></i>No categories found in the store.
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            @foreach (var item in Model)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm border-0 rounded-3">
                        <div class="card-body d-flex flex-column">
                                <a asp-action="Details" asp-route-id="@item.Id" class="text-decoration-none d-flex align-items-center mb-3">
                                    <div class="rounded-circle bg-primary-subtle text-primary d-flex align-items-center justify-content-center me-3" style="width: 48px; height: 48px; font-weight: bold; font-size: 1.2rem;">
                                        <i class="bi bi-tag-fill"></i>
                                    </div>
                                    <div class="flex-grow-1 text-truncate">
                                        <h5 class="card-title mb-0 fw-bold text-truncate text-dark" title="@item.Name">@item.Name</h5>
                                        <span class="badge bg-@(item.IsVisible ? "success" : "secondary")-subtle text-@(item.IsVisible ? "success" : "secondary")">
                                            @(item.IsVisible ? "Active" : "Hidden")
                                        </span>
                                    </div>
                                </a>
                                <p class="card-text text-muted mb-3">
                                    Books in Store: <span class="badge bg-info-subtle text-info-emphasis border">@item.BookCount @(item.BookCount == 1 ? "Book" : "Books")</span>
                                </p>

                                <div class="mt-auto pt-3 border-top d-flex justify-content-between align-items-center">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-secondary" title="View Category & Books">
                                            <i class="bi bi-eye"></i> Details
                                        </a>
                                        @if (isAdmin)
                                        {
                                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-warning" title="Edit Category">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger" title="Delete Category">
                                                <i class="bi bi-trash"></i>
                                            </a>
                                        }
                                    </div>
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-primary btn-sm">
                                        Explore Books &rarr;
                                    </a>
                                </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>