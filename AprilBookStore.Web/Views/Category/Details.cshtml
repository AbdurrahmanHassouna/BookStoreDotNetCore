@model CategoryViewModel

@{
    ViewData["Title"] = $"{Model.Name} - Category Details";
    var isAdmin = User.IsInRole("SuperAdmin") || User.IsInRole("Admin");
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-2">
        <div>
            <h1 class="h2 text-primary mb-0">@Model.Name</h1>
            <small class="text-muted">Category Details & Catalog</small>
        </div>
        <div>
            @if (isAdmin)
            {
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning me-2">
                    <i class="bi bi-pencil me-1"></i>Edit
                </a>
            }
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i>Back to Categories
            </a>
        </div>
    </div>

    <div class="row g-4 mb-5">
        <!-- Category Sidebar -->
        <div class="col-md-4">
            <div class="card shadow-sm border-0 h-100 rounded-3">
                <div class="card-body text-center p-4">
                    <div class="rounded-circle bg-primary-subtle text-primary d-inline-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px; font-size: 2.2rem;">
                        <i class="bi bi-tag-fill"></i>
                    </div>
                    <h4 class="card-title fw-bold">@Model.Name</h4>
                    <p class="text-muted mb-3">Book Category</p>
                    <hr />
                    <div class="d-flex justify-content-around text-center mb-3">
                        <div>
                            <span class="text-muted small d-block">Available Books</span>
                            <span class="fs-5 fw-bold text-primary">@Model.BookCount</span>
                        </div>
                        <div>
                            <span class="text-muted small d-block">Catalog Status</span>
                            @if (Model.IsVisible)
                            {
                                <span class="badge bg-success-subtle text-success border border-success-subtle">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">Hidden</span>
                            }
                        </div>
                    </div>
                    @if (isAdmin)
                    {
                        <div class="small text-muted border-top pt-2 text-start">
                            <div><i class="bi bi-calendar-plus me-1"></i>Created: @Model.CreatedDate.ToString("g")</div>
                            <div><i class="bi bi-clock-history me-1"></i>Updated: @Model.UpdatedDate.ToString("g")</div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Category Books Grid -->
        <div class="col-md-8">
            <div class="card shadow-sm border-0 h-100 rounded-3">
                <div class="card-header bg-light d-flex justify-content-between align-items-center py-3">
                    <h5 class="mb-0 fw-bold">
                        <i class="bi bi-collection me-2 text-primary"></i>Books in @Model.Name
                    </h5>
                    <span class="badge bg-primary rounded-pill">@Model.Books.Count Books</span>
                </div>
                <div class="card-body p-4">
                    @if (Model.Books != null && Model.Books.Any())
                    {
                        <div class="row row-cols-1 row-cols-sm-2 g-3">
                            @foreach (var book in Model.Books)
                            {
                                <div class="col">
                                    <div class="card h-100 border shadow-sm rounded-3">
                                        <a asp-controller="Books" asp-action="Details" asp-route-id="@book.Id" class="text-decoration-none">
                                            <img asp-append-version="true"
                                                 src="@(string.IsNullOrEmpty(book.ImgPath) ? "/Assets/download.png" : book.ImgPath)"
                                                 class="card-img-top rounded-top-3"
                                                 style="height: 220px; object-fit: cover;"
                                                 loading="lazy"
                                                 alt="Cover of @book.Name" />
                                        </a>
                                        <div class="card-body d-flex flex-column p-3">
                                            <h6 class="card-title fw-bold text-truncate mb-1" title="@book.Name">
                                                <a asp-controller="Books" asp-action="Details" asp-route-id="@book.Id" class="text-decoration-none text-dark">
                                                    @book.Name
                                                </a>
                                            </h6>
                                            <small class="text-muted d-block mb-2">
                                                <i class="bi bi-person me-1"></i>@book.AuthorName
                                            </small>
                                            <div class="mb-2">
                                                @for (int i = 1; i <= 5; i++)
                                                {
                                                    <i class="bi @(i <= (int)(book.BookStar ?? 0) ? "bi-star-fill text-warning" : "bi-star text-muted")"></i>
                                                }
                                                @if (book.BookStar.HasValue && book.BookStar > 0)
                                                {
                                                    <span class="small text-muted ms-1">(@book.BookStar.Value.ToString("0.0"))</span>
                                                }
                                            </div>
                                            <div class="mt-auto d-flex justify-content-between align-items-center pt-2 border-top">
                                                <span class="fw-bold fs-6 text-primary">$@string.Format("{0:n2}", book.Price)</span>
                                                <div class="d-flex gap-1">
                                                    @if (User.Identity?.IsAuthenticated == true)
                                                    {
                                                        @if (book.QuantityInStock <= 0)
                                                        {
                                                            <button type="button" class="btn btn-outline-danger btn-sm" disabled title="Out of stock">
                                                                <i class="bi bi-x-circle"></i>
                                                            </button>
                                                        }
                                                        else
                                                        {
                                                            <button type="button" class="btn btn-primary btn-sm addToCartBtn" data-book-id="@book.Id" title="Add to Cart">
                                                                <i class="bi bi-cart-plus"></i>
                                                            </button>
                                                        }
                                                    }
                                                    else
                                                    {
                                                        <a asp-area="Identity" asp-page="/account/login" class="btn btn-outline-primary btn-sm" title="Sign in to purchase">
                                                            <i class="bi bi-cart-plus"></i>
                                                        </a>
                                                    }
                                                    <a asp-controller="Books" asp-action="Details" asp-route-id="@book.Id" class="btn btn-outline-secondary btn-sm" title="View Details">
                                                        <i class="bi bi-eye"></i>
                                                    </a>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info mb-0">
                            <i class="bi bi-info-circle me-2"></i>No published books found in this category yet.
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).on('click', '.addToCartBtn', function () {
            var $btn = $(this);
            var bookId = $btn.data('book-id');
            $.ajax({
                url: '@Url.Action("AddToCart", "Cart")',
                type: 'POST',
                data: { bookId: bookId },
                success: function (result) {
                    $('#cartItemCount').html(result);
                    if (typeof toastr !== 'undefined') {
                        toastr.success('Item added to cart successfully!');
                    }
                },
                error: function () {
                    if (typeof toastr !== 'undefined') {
                        toastr.error('An error occurred while adding the item to the cart.');
                    }
                }
            });
        });
    </script>
}