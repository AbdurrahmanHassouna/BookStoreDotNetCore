@using AprilBookStore.Application.Interfaces
@using AprilBookStore.Domain.Entities
@using Microsoft.AspNetCore.Hosting
@using Microsoft.AspNetCore.Mvc.ViewEngines
@using System.Security.Claims
@inject SignInManager<ApplicationUser> signInManager
@inject ICartService cartService
@inject IWebHostEnvironment Environment
@inject ICompositeViewEngine Engine
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - AprilBookStore</title>
    <link rel="icon" type="image/x-icon" href="/Assets/download.png"/>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
          integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>

</head>
<body>
<div id="antiForgeryTokenContainer" class="d-none">@Html.AntiForgeryToken()</div>
<header>
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow-sm">
        <div class="container-fluid px-4 px-lg-5">
            <a class="navbar-brand fw-bold d-flex align-items-center gap-2" asp-area="" asp-controller="Home" asp-action="Index">
                <i class="bi bi-book-half fs-3 text-warning"></i>
                <span>AprilBookStore</span>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                    data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent"
                    aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarSupportedContent">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    <li class="nav-item">
                        <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">Books</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-area="" asp-controller="Authors" asp-action="Index">Authors</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-area="" asp-controller="Category" asp-action="Index">Categories</a>
                    </li>

                    @if (User.IsInRole("SuperAdmin") || User.IsInRole("Admin"))
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" id="navbarDarkDropdownMenuLink" role="button"
                               data-bs-toggle="dropdown" aria-expanded="false">
                                Admin
                            </a>
                            <ul class="dropdown-menu" aria-labelledby="navbarDarkDropdownMenuLink">
                                <li><a class="dropdown-item" asp-controller="Books" asp-action="Create">Add Book</a></li>
                                <li><a class="dropdown-item" asp-controller="Orders" asp-action="Index">Orders</a></li>
                                <li><a class="dropdown-item" asp-controller="Books" asp-action="Index">Manage Books</a></li>
                                <li><a class="dropdown-item" asp-controller="Authors" asp-action="Index">Manage Authors</a></li>
                            </ul>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" id="navbarAdminDropdownMenuLink" role="button"
                               data-bs-toggle="dropdown" aria-expanded="false">
                                Administration
                            </a>
                            <ul class="dropdown-menu" aria-labelledby="navbarAdminDropdownMenuLink">
                                <li><a class="dropdown-item" asp-action="ListUsers" asp-controller="Administration">Users</a></li>
                                <li><a class="dropdown-item" asp-action="ListRoles" asp-controller="Administration">Roles</a></li>
                            </ul>
                        </li>
                    }
                </ul>

                <partial name="_LoginPartial"/>

                <form class="d-flex ms-lg-3 my-2 my-lg-0" role="search"
                      asp-controller="@(User.IsInRole("SuperAdmin") || User.IsInRole("Admin") ? "Books" : "Home")"
                      asp-action="Index" method="post">
                    <div class="position-relative">
                        <input class="form-control rounded-pill pe-5" type="search" placeholder="Search books..." aria-label="Search"
                               name="Search"
                               id="@(User.IsInRole("SuperAdmin") || User.IsInRole("Admin") ? "SearchAdmin" : "SearchHome")">
                        <button class="btn btn-link text-secondary position-absolute end-0 top-50 translate-middle-y me-1 p-1 text-decoration-none border-0" type="submit" aria-label="Search">
                            <i class="bi bi-search"></i>
                        </button>
                    </div>
                </form>

                @if (User.Identity?.IsAuthenticated == true && ViewContext.RouteData.Values["controller"]?.ToString() != "Cart" && ViewContext.RouteData.Values["controller"]?.ToString() != "Orders")
                {
                    <a class="nav-link position-relative ms-3 text-white d-flex align-items-center" asp-controller="Cart" asp-action="Index" title="Shopping Cart">
                        <i class="bi bi-cart3 fs-4"></i>
                        <span id="cartItemCount"
                              class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                            @await Html.PartialAsync("_CartCount", await cartService.GetCartItemsCountAsync(User.FindFirstValue(ClaimTypes.NameIdentifier) ?? ""))
                        </span>
                    </a>
                }
            </div>
        </div>
    </nav>
</header>

<main role="main">
    <div class="container-xxl my-4">
        <partial name="_CookieConsentPartial" optional/>
        @RenderBody()
    </div>
</main>

<footer class="footer mt-auto">
    <div class="container-fluid px-4 px-lg-5 d-flex flex-column flex-sm-row justify-content-between align-items-center gap-2">
        <span>&copy; 2024 - AprilBookStore</span>
        @{
            var foundPrivacy = Url.Page("/Privacy", new { area = "" });
        }
        @if (foundPrivacy != null)
        {
            <a class="text-muted" asp-area="" asp-page="/Privacy">Privacy</a>
        }
    </div>
</footer>

<script src="https://code.jquery.com/jquery-3.7.1.min.js"
        integrity="sha256-/JqT3SQfawRcv/BIHPThkBvs0OEvtFFmqPF/lYI/Cxo="
        crossorigin="anonymous"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
        crossorigin="anonymous"></script>
<script src="https://code.jquery.com/ui/1.13.3/jquery-ui.min.js"
        integrity="sha256-sw0i1m7pY9P4U2t0KzC9d8S3iE7u11u7t3o0y+G7I78="
        crossorigin="anonymous"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>

@await RenderSectionAsync("Scripts", required: false)

<script>
    $(function () {
        $("#SearchHome, #SearchAdmin , #SearchManage").autocomplete({
            source: function (request, response) {
                $.ajax({
                    url: '@Url.Action("AutoComplete", User.IsInRole("SuperAdmin") || User.IsInRole("Admin") ? "Books" : "Home")',
                    data: {term: request.term},
                    dataType: "json",
                    success: function (data) {
                        response(data);
                    }
                });
            }
        });
    });
</script>
</body>
</html>