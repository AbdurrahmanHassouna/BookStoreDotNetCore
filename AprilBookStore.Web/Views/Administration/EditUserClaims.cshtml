@model UserClaimsViewModel

@{
    ViewBag.Title = "Edit Claims";
}

<div class="container workspace-page admin-workspace py-4">
    <header class="page-heading mb-4"><p class="page-eyebrow">Store administration</p><h1><i class="bi bi-card-checklist me-2" aria-hidden="true"></i>User claims</h1><p class="text-muted mb-0">Choose the claims assigned to this account.</p></header>
<form method="post" class="workspace-form">
    <div class="card">
        <div class="card-header">
            <h2>Manage User Claims</h2>
        </div>
        <div class="card-body">
            @for (int i = 0; i<Model.Claims.Count; i++)
            {
                <div class="form-check m-1">
                    
                    <input type="hidden" asp-for="@Model.Claims[i].ClaimType" />
                    <input asp-for="@Model.Claims[i].IsSelected" class="form-check-input" />
                    <label class="form-check-label" asp-for="@Model.Claims[i].IsSelected">
                        @Model.Claims[i].ClaimType
                    </label>
                </div>
            }
            <div asp-validation-summary="All" class="text-danger"></div>
        </div>
        <div class="card-footer">
            <input type="submit" value="Update" class="btn btn-primary" style="width:auto" />
            <a asp-action="EditUser" asp-route-id="@Model.UserId" class="btn btn-primary"
               style="width:auto">Cancel</a>

        </div>
    </div>
</form>
</div>
