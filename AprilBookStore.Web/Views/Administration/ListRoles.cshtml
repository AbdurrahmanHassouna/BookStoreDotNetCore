@using Microsoft.AspNetCore.Authorization
@model IEnumerable<AprilBookStore.Application.Models.Administration.RoleDto>
@inject IAuthorizationService authorize
@{
    ViewBag.Title = "Roles";
}

<div class="container workspace-page admin-workspace py-4">
<header class="page-heading mb-4"><p class="page-eyebrow">Store administration</p><h1><i class="bi bi-shield-lock me-2" aria-hidden="true"></i>Roles</h1><p class="text-muted mb-0">Manage access roles for bookstore accounts.</p></header>

@if (Model.Any())
{
    <a class="btn btn-primary mb-3" style="width:auto" asp-action="CreateRole"
       asp-controller="Administration">Add new role</a>

    foreach (var role in Model)
    {
        <div class="card mb-3">
            <div class="card-header">
                Role Id : @role.Id
            </div>
            <div class="card-body">
                <h5 class="card-title">@role.Name</h5>
            </div>
            <div class="card-footer">
                <form method="post" asp-action="DeleteRole" asp-controller="Administration" asp-route-id="@role.Id">
                    @if ((await authorize.AuthorizeAsync(User, "EditRolePolicy")).Succeeded)
                    {
                        <a asp-action="EditRole" asp-route-id="@role.Id" class="btn btn-primary">Edit</a>
                    }
                    @if ((await authorize.AuthorizeAsync(User, "DeleteRolePolicy")).Succeeded)
                    { 
                        <button type="submit" onclick="return confirm('are you sure to delete @role.Name ?')" class="btn btn-danger">
                            Delete
                        </button>
                    }
                </form>
            </div>
        </div>
    }
}
else
{
    <div class="card">
        <div class="card-header">
            No roles created yet
        </div>
        <div class="card-body">
            <h5 class="card-title">
                Use the button below to create a role
            </h5>
            <a class="btn btn-primary" style="width:auto"
               asp-controller="Administration" asp-action="CreateRole">
                Create Role
            </a>
        </div>
    </div>
}
 </div>
