@model IEnumerable<AprilBookStore.Application.Models.Administration.UserDto>

@{
    ViewBag.Title = "All Users";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-2">
        <div>
            <h1 class="h2 text-primary mb-0">All Users</h1>
            <small class="text-muted">Manage system users, roles, and permissions</small>
        </div>
        <a class="btn btn-primary" asp-area="Identity" asp-page="/Account/Register">
            <i class="bi bi-person-plus-fill me-1"></i>Add New User
        </a>
    </div>

    @if (Model.Any())
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            @foreach (var user in Model)
            {
                <div class="col">
                    <div class="card h-100 border-0 shadow-sm rounded-3">
                        <div class="card-body">
                            <div class="d-flex align-items-center mb-3">
                                <div class="rounded-circle bg-primary-subtle text-primary d-flex align-items-center justify-content-center me-3" style="width: 42px; height: 42px;">
                                    <i class="bi bi-person fs-5"></i>
                                </div>
                                <div class="flex-grow-1 text-truncate">
                                    <h6 class="card-title mb-0 fw-bold text-truncate" title="@user.UserName">@user.UserName</h6>
                                    <small class="text-muted text-truncate d-block">ID: @user.Id</small>
                                </div>
                            </div>
                        </div>
                        <div class="card-footer bg-transparent border-top d-flex justify-content-end gap-2 py-3">
                            <form method="post" asp-action="DeleteUser" asp-controller="Administration" asp-route-id="@user.Id" class="d-flex gap-2">
                                <a asp-action="EditUser" asp-route-id="@user.Id" class="btn btn-sm btn-outline-warning">
                                    <i class="bi bi-pencil me-1"></i>Edit
                                </a>
                                <button type="submit" onclick="return confirm('Are you sure you want to delete @user.UserName?')" class="btn btn-sm btn-outline-danger">
                                    <i class="bi bi-trash me-1"></i>Delete
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm rounded-3 text-center p-5">
            <div class="mb-3">
                <i class="bi bi-people text-muted" style="font-size: 3rem;"></i>
            </div>
            <h4 class="text-secondary fw-semibold">No Users Found</h4>
            <p class="text-muted">There are no users registered in the system yet.</p>
            <div class="mt-2">
                <a class="btn btn-primary" asp-area="Identity" asp-page="/Account/Register">
                    <i class="bi bi-person-plus-fill me-1"></i>Create User
                </a>
            </div>
        </div>
    }
</div>