@model List<UserRoleViewModel>
@{
    ViewBag.Title = "Edit Roles'Users";
    var roleId = ViewBag.roleId;
}


<div class="container workspace-page admin-workspace py-4">
    <header class="page-heading mb-4"><p class="page-eyebrow">Store administration</p><h1><i class="bi bi-people me-2" aria-hidden="true"></i>Role members</h1><p class="text-muted mb-0">Choose which users belong to this role.</p></header>
<form method="post" class="workspace-form">
    <div class="card">
        <div class="card-header">
            <h2>Add or remove users from this role</h2>
        </div>
        <div class="card-body">
            <div asp-validation-summary="All" class="text-danger mb-2"></div>
            @for (int i = 0; i < Model.Count; i++)
            {
                <div class="form-check m-1">
                    <input type="hidden" asp-for="@Model[i].UserId" />
                    <input type="hidden" asp-for="@Model[i].UserName" />
                    <input asp-for="@Model[i].IsSelected" class="form-check-input" />
                    <label class="form-check-label" asp-for="@Model[i].IsSelected">
                        @Model[i].UserName
                    </label>
                </div>
            }
            @* @foreach(var user in Model)
            {
                <div class="form-check m-1">
                    <input type="hidden" asp-for="@user.UserId" />
                    <input type="hidden" asp-for="@user.UserName" />
                    <input asp-for="@user.IsSelected" class="form-check-input" />  /// doesn't work correctly'
                    <label class="form-check-label" asp-for="@user.IsSelected">
                        @user.UserName
                    </label>
                </div>
            } *@
        </div>
        <div class="card-footer">
            <input type="submit" value="Update" class="btn btn-primary"
                   style="width:auto" />
            <a asp-action="EditRole" asp-route-id="@roleId"
               class="btn btn-primary" style="width:auto">Cancel</a>
        </div>
    </div>
</form>
</div>
